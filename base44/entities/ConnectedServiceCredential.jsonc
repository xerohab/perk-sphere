{
  "name": "ConnectedServiceCredential",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "description": "google or x"
    },
    "connected_service_id": {
      "type": "string",
      "description": "Reference to the ConnectedService metadata record"
    },
    "encrypted_access_token": {
      "type": "string",
      "description": "AES-GCM ciphertext hex of the OAuth access token"
    },
    "access_token_iv": {
      "type": "string",
      "description": "AES-GCM initialization vector hex"
    },
    "encrypted_refresh_token": {
      "type": "string",
      "description": "AES-GCM ciphertext hex of the OAuth refresh token (empty if none)"
    },
    "refresh_token_iv": {
      "type": "string"
    },
    "token_expiry": {
      "type": "string",
      "format": "date-time"
    },
    "scopes": {
      "type": "string"
    },
    "provider_user_id": {
      "type": "string"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "provider"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}