{
  "name": "ConnectedService",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "service": {
      "type": "string",
      "description": "Provider key: google or x"
    },
    "account_handle": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "pending",
        "disconnected",
        "not_configured"
      ],
      "default": "not_configured"
    },
    "external_account_id": {
      "type": "string"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_user_id": {
      "type": "string",
      "description": "Authoritative external identity from the provider (e.g. Google sub, X user id)"
    },
    "provider_username": {
      "type": "string"
    },
    "provider_display_name": {
      "type": "string"
    },
    "provider_email": {
      "type": "string"
    },
    "token_expiry": {
      "type": "string",
      "format": "date-time",
      "description": "Non-secret metadata: when the access token expires"
    },
    "scopes": {
      "type": "string",
      "description": "Space-separated scopes granted by the provider"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "service"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}