{
  "name": "TrackedAccount",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string"
    },
    "destination_type": {
      "type": "string",
      "enum": [
        "channel",
        "account",
        "video",
        "post",
        "other"
      ]
    },
    "account_name": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "profile_url": {
      "type": "string"
    },
    "external_platform_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "preferred",
        "partner",
        "neutral",
        "rival",
        "other"
      ],
      "default": "neutral"
    },
    "eligibility": {
      "type": "string",
      "enum": [
        "allowed",
        "neutral",
        "disallowed"
      ],
      "default": "neutral"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "publicly_visible": {
      "type": "boolean",
      "default": true
    },
    "tracking_enabled": {
      "type": "boolean",
      "default": true
    },
    "points_eligible": {
      "type": "boolean",
      "default": true
    },
    "xp_eligible": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "platform",
    "account_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}