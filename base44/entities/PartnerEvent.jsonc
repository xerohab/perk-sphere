{
  "name": "PartnerEvent",
  "type": "object",
  "properties": {
    "partner_integration_id": {
      "type": "string"
    },
    "partner_name": {
      "type": "string"
    },
    "external_event_id": {
      "type": "string",
      "description": "Idempotent event ID supplied by the partner"
    },
    "event_type": {
      "type": "string"
    },
    "user_reference": {
      "type": "string",
      "description": "Partner's account reference for the user"
    },
    "user_id": {
      "type": "string",
      "description": "Resolved Perk Sphere user ID if linked"
    },
    "task_id": {
      "type": "string"
    },
    "content_id": {
      "type": "string"
    },
    "content_url": {
      "type": "string"
    },
    "eligible_seconds": {
      "type": "number",
      "default": 0
    },
    "event_data": {
      "type": "object"
    },
    "source_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    },
    "processing_status": {
      "type": "string",
      "enum": [
        "pending",
        "processed",
        "duplicate",
        "rejected",
        "error"
      ],
      "default": "pending"
    },
    "completion_triggered": {
      "type": "boolean",
      "default": false
    },
    "completion_id": {
      "type": "string"
    },
    "error_code": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    }
  },
  "required": [
    "partner_integration_id",
    "external_event_id",
    "event_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}