{
  "name": "Task",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "visit_website",
        "visit_page",
        "watch_video",
        "live_stream",
        "spend_time",
        "daily_visit",
        "complete_activity",
        "campaign_task",
        "custom"
      ],
      "default": "custom"
    },
    "destination_id": {
      "type": "string"
    },
    "destination_type": {
      "type": "string",
      "enum": [
        "website",
        "tracked_account"
      ]
    },
    "destination_name": {
      "type": "string"
    },
    "destination_platform": {
      "type": "string"
    },
    "content_id": {
      "type": "string"
    },
    "content_url": {
      "type": "string"
    },
    "content_title": {
      "type": "string"
    },
    "channel_name": {
      "type": "string"
    },
    "required_seconds": {
      "type": "number",
      "default": 0
    },
    "required_percentage": {
      "type": "number",
      "default": 0
    },
    "require_continuous": {
      "type": "boolean",
      "default": false
    },
    "completion_mode": {
      "type": "string",
      "enum": [
        "fixed_duration",
        "until_broadcast_end",
        "duration_plus_end"
      ],
      "default": "fixed_duration",
      "description": "Live stream completion mode: fixed_duration = reach required seconds; until_broadcast_end = watch until broadcast ends; duration_plus_end = both"
    },
    "max_credited_seconds": {
      "type": "number",
      "default": 0,
      "description": "Maximum credited viewing time for live streams (does not prove broadcast ended)"
    },
    "absence_tolerance_seconds": {
      "type": "number",
      "default": 0,
      "description": "Allowed interruption or absence tolerance for live stream viewing"
    },
    "broadcast_status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "ended",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "partner_integration_id": {
      "type": "string",
      "description": "Reference to PartnerIntegration for partner-backed tasks"
    },
    "event_start": {
      "type": "string",
      "format": "date-time"
    },
    "event_end": {
      "type": "string",
      "format": "date-time"
    },
    "available_from": {
      "type": "string",
      "format": "date-time"
    },
    "available_until": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string"
    },
    "points_reward": {
      "type": "number",
      "default": 0
    },
    "xp_reward": {
      "type": "number",
      "default": 0
    },
    "achievement_id": {
      "type": "string"
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "none",
        "points",
        "xp",
        "points_xp",
        "achievement"
      ],
      "default": "none"
    },
    "completion_limit_type": {
      "type": "string",
      "enum": [
        "once_ever",
        "once_daily",
        "once_weekly",
        "once_campaign",
        "unlimited",
        "custom_max"
      ],
      "default": "once_ever"
    },
    "max_completions": {
      "type": "number",
      "default": 0
    },
    "cooldown_seconds": {
      "type": "number",
      "default": 0
    },
    "verification_mode": {
      "type": "string",
      "enum": [
        "manual",
        "client_assisted",
        "trusted_automatic"
      ],
      "default": "client_assisted"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "publicly_visible": {
      "type": "boolean",
      "default": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "terms": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "task_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}