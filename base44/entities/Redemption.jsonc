{
  "name": "Redemption",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "reward_id": {
      "type": "string"
    },
    "reward_name": {
      "type": "string"
    },
    "points_spent": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "fulfilled",
        "rejected",
        "cancelled",
        "refunded"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string"
    },
    "fulfilment_info": {
      "type": "string"
    },
    "admin_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "reward_id",
    "points_spent"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}