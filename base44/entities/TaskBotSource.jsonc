{
  "name": "TaskBotSource",
  "type": "object",
  "properties": {
    "source_key": {
      "type": "string",
      "enum": [
        "xerostreams"
      ]
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "partial",
        "full_episode",
        "alternate"
      ]
    },
    "partial_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 1800
    },
    "daily_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "lookback_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    }
  },
  "required": [
    "source_key",
    "enabled",
    "mode",
    "partial_seconds",
    "daily_max",
    "lookback_days"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}
