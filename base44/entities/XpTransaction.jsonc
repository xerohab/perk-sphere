{
  "name": "XpTransaction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "xp_amount": {
      "type": "number"
    },
    "xp_before": {
      "type": "number"
    },
    "xp_after": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "related_activity_id": {
      "type": "string"
    },
    "admin_id": {
      "type": "string"
    },
    "admin_note": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "xp_amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}