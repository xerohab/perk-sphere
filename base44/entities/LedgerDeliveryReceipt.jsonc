{
  "name": "LedgerDeliveryReceipt",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "delivery_uuid": {
      "type": "string"
    },
    "operation_uuid": {
      "type": "string"
    },
    "operation_type": {
      "type": "string"
    },
    "points_delta": {
      "type": "string"
    },
    "xp_delta": {
      "type": "string"
    },
    "payload_hash": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "delivery_uuid",
    "operation_uuid",
    "operation_type",
    "points_delta",
    "xp_delta",
    "payload_hash"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}
