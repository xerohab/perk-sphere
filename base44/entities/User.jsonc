{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user"
    },
    "username": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "restricted",
        "suspended",
        "banned"
      ],
      "default": "active",
      "rls": {
        "write": false
      }
    },
    "points_balance": {
      "type": "number",
      "default": 0,
      "rls": {
        "write": false
      }
    },
    "loyalty_xp": {
      "type": "number",
      "default": 0,
      "rls": {
        "write": false
      }
    },
    "loyalty_rank": {
      "type": "string",
      "default": "Bronze",
      "rls": {
        "write": false
      }
    },
    "profile_image": {
      "type": "string"
    },
    "email_verified": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": false
      }
    },
    "streak_current": {
      "type": "number",
      "default": 0,
      "rls": {
        "write": false
      }
    },
    "streak_longest": {
      "type": "number",
      "default": 0,
      "rls": {
        "write": false
      }
    },
    "streak_last_qualifying_date": {
      "type": "string",
      "format": "date",
      "rls": {
        "write": false
      }
    },
    "theme_preference": {
      "type": "string",
      "enum": [
        "system",
        "light",
        "dark"
      ]
    }
  }
}