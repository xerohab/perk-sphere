{
  "name": "TrustedSessionProgress",
  "type": "object",
  "properties": {
    "session_uuid": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "user_reference": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "device_uuid": {
      "type": "string"
    },
    "highest_eligible_seconds": {
      "type": "number",
      "default": 0
    },
    "verification_state": {
      "type": "string",
      "enum": [
        "received",
        "verified",
        "rejected",
        "invalidated"
      ],
      "default": "received"
    },
    "last_event_id": {
      "type": "string"
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "session_uuid",
    "task_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}