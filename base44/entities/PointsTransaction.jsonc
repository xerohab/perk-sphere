{
  "name": "PointsTransaction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "balance_before": {
      "type": "number"
    },
    "balance_after": {
      "type": "number"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "earned",
        "manual_credit",
        "manual_deduction",
        "redemption",
        "refund",
        "promotion",
        "correction",
        "expired",
        "other"
      ]
    },
    "reason": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "related_activity_id": {
      "type": "string"
    },
    "related_redemption_id": {
      "type": "string"
    },
    "admin_id": {
      "type": "string"
    },
    "admin_note": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "amount",
    "transaction_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}