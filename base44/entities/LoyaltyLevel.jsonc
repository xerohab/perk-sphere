{
  "name": "LoyaltyLevel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "minimum_xp": {
      "type": "number",
      "default": 0
    },
    "icon": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "minimum_xp"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}