{
  "name": "PartnerIntegration",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "partner_type": {
      "type": "string",
      "enum": [
        "custom_website",
        "streaming_platform",
        "membership_subscription",
        "wordpress_woocommerce",
        "other"
      ],
      "default": "custom_website"
    },
    "integration_kit_type": {
      "type": "string",
      "enum": [
        "universal_api",
        "wordpress_woocommerce",
        "streaming_sdk",
        "custom"
      ],
      "default": "universal_api",
      "description": "Which integration kit/package this partner uses to send events to the Linux API"
    },
    "website_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "logo": {
      "type": "string"
    },
    "verified_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integration_status": {
      "type": "string",
      "enum": [
        "pending",
        "linux_integration_pending",
        "setup_required",
        "active",
        "suspended",
        "disabled",
        "archived"
      ],
      "default": "pending",
      "description": "linux_integration_pending = Linux provisioning endpoint unavailable; admin can retry"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "domain_verified",
        "credential_verified",
        "fully_verified"
      ],
      "default": "unverified",
      "description": "Independent from integration_status: tracks domain ownership, credential proof-of-possession, and test-event verification"
    },
    "supported_event_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_task_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "partner_key_id": {
      "type": "string",
      "description": "Linux-issued partner key ID (psp_ prefix). Used in X-PS-Partner-Key header for partner HMAC auth. Provisioned by Linux."
    },
    "partner_secret_hash": {
      "type": "string",
      "description": "SHA-256 hash of the HMAC secret for identification only \u2014 never used for verification. Never returned in responses."
    },
    "linux_api_partner_id": {
      "type": "string",
      "description": "Linux partner_uuid \u2014 immutable after confirmation unless audited admin correction. Set by Linux during provisioning. Required for credential rotation and revocation."
    },
    "domain_verification_token": {
      "type": "string",
      "description": "Random token the partner must publish in a DNS TXT or well-known file to prove domain ownership. Provisioned by Linux. Never returned in general responses."
    },
    "domain_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "proof_of_possession_verified": {
      "type": "boolean",
      "default": false,
      "description": "True once the partner has demonstrated they hold the HMAC secret by signing a challenge"
    },
    "proof_of_possession_at": {
      "type": "string",
      "format": "date-time"
    },
    "test_event_id": {
      "type": "string",
      "description": "The external_event_id of the partner's successful verification test event"
    },
    "test_event_verified": {
      "type": "boolean",
      "default": false
    },
    "test_event_at": {
      "type": "string",
      "format": "date-time"
    },
    "setup_checklist": {
      "type": "object",
      "description": "Tracks onboarding steps: base44_registered, credentials_generated, domain_verified, admin_reviewed, linux_api_configured, partner_implemented, proof_of_possession, test_event_verified, activated"
    },
    "daily_points_limit": {
      "type": "number",
      "default": 0,
      "description": "Per-partner daily Points cap across all users (0 = no cap)"
    },
    "daily_xp_limit": {
      "type": "number",
      "default": 0,
      "description": "Per-partner daily XP cap across all users (0 = no cap)"
    },
    "points_per_event": {
      "type": "number",
      "default": 0,
      "description": "Per-partner reward policy: Points issued per verified eligible event (0 = task-driven only)"
    },
    "xp_per_event": {
      "type": "number",
      "default": 0,
      "description": "Per-partner reward policy: XP issued per verified eligible event (0 = task-driven only)"
    },
    "connection_health": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "down",
        "unconfigured"
      ],
      "default": "unconfigured"
    },
    "last_event_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_failure_at": {
      "type": "string",
      "format": "date-time"
    },
    "total_events_received": {
      "type": "number",
      "default": 0
    },
    "total_delivery_failures": {
      "type": "number",
      "default": 0
    },
    "setup_instructions": {
      "type": "string"
    },
    "credential_handoff_token_hash": {
      "type": "string",
      "description": "SHA-256 hash of the one-time credential handoff token. Cleared after use. Never returned in responses."
    },
    "credential_handoff_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the credential handoff token expires (5-minute TTL)."
    },
    "active": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "partner_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}