{
  "name": "PartnerCredential",
  "type": "object",
  "properties": {
    "partner_integration_id": {
      "type": "string"
    },
    "encrypted_hmac_secret": {
      "type": "string",
      "description": "AES-GCM ciphertext hex of the partner HMAC secret"
    },
    "hmac_secret_iv": {
      "type": "string",
      "description": "AES-GCM initialization vector hex"
    },
    "rotated_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "partner_integration_id",
    "encrypted_hmac_secret"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}